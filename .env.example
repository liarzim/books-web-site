# --- Admin editor auth (Google sign-in) ---
# Create at https://console.cloud.google.com/apis/credentials -> "Create
# Credentials" -> "OAuth client ID" -> Application type: Web application.
#   Authorized redirect URI = <your deployed origin>/api/admin/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Failsafe only -- the real member list (who's allowed in, and whether
# they're an "admin" or an "editor") lives in content/members.json and is
# managed from /admin/members once you're signed in. These two vars are
# just a bootstrap so you can never be fully locked out: anyone matching
# either one gets in with the "admin" role even if members.json is ever
# empty, missing, or broken. Keep your own email in ADMIN_ALLOWED_EMAILS
# permanently as that safety net.
#   - exact addresses, comma-separated
#   - anyone on a given Google Workspace domain
ADMIN_ALLOWED_EMAILS=you@example.com
ADMIN_ALLOWED_DOMAIN=

# Random long string used to sign the admin's session cookie. Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- GitHub write access (the admin editor's shared service credential) ---
# A fine-grained Personal Access Token, scoped to ONLY this repo, with
# Contents: Read and write permission. Create at
# https://github.com/settings/personal-access-tokens/new
# This token is never seen by editors -- it's what the server uses to
# commit their changes after Google sign-in has authorized them.
GITHUB_ADMIN_TOKEN=
GITHUB_REPO=owner/repo-name
GITHUB_BRANCH=main
